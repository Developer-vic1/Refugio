# Refugio Vida Animal — Laragon / PHP MVC / Tailwind
# Nunca subir secretos, credenciales ni datos personales.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
auth.json

# Dependencias y caches locales
/node_modules/
/vendor/
/.cache/
/.phpunit.cache/
/coverage/
/dist/
/build/
/tmp/
/temp/
/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Contenido creado por usuarios y archivos sensibles
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/review/*
!/storage/app/review/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/*
!/storage/framework/.gitkeep
/public/uploads/
/public/storage/

# Archivos con datos locales, exportaciones SQL y respaldos
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.sqlite
*.sqlite3
*.zip
*.tar.gz
/backups/
/database/backups/
/storage/backups/

# Archivos generados temporales (mantener CSS/JS compilados necesarios para Laragon)
/public/assets/css/*.map
/public/assets/js/*.map
*.tsbuildinfo

# IDE, sistema operativo y archivos personales
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.example.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Herramientas locales y evidencias de revisión (nunca versionar)
.codex/
.playwright-cli/
/output/
